    <string name="p_grounding">5-4-3-2-1 grounding</string>
    <string name="p_grounding_desc">Come back to the room through your senses.</string>
    <string-array name="p_grounding_heads">
        <item>Name 5 things you can see.</item>
        <item>Notice 4 things you can feel.</item>
        <item>Listen for 3 things you can hear.</item>
        <item>Find 2 things you can smell.</item>
        <item>Notice 1 thing you can taste.</item>
        <item>Take one slow breath.</item>
    </string-array>
    <string-array name="p_grounding_hints">
        <item>Let your eyes move slowly. A colour, an edge, a shadow.</item>
        <item>Your feet on the floor, fabric on your skin, the air temperature.</item>
        <item>Near sounds first, then the faraway ones.</item>
        <item>If nothing comes, recall a smell you like.</item>
        <item>Or simply notice the inside of your mouth.</item>
        <item>Notice how you feel now, compared to three minutes ago.</item>
    </string-array>

    <string name="p_scan">Body scan</string>
    <string name="p_scan_desc">Move attention slowly from feet to crown.</string>
    <string-array name="p_scan_heads">
        <item>Settle into your seat.</item>
        <item>Bring attention to your feet.</item>
        <item>Move up through your legs.</item>
        <item>Rest attention on belly and chest.</item>
        <item>Notice shoulders, arms and hands.</item>
        <item>Soften jaw, eyes and forehead.</item>
    </string-array>
    <string-array name="p_scan_hints">
        <item>Let your hands rest. Close your eyes if that feels fine.</item>
        <item>Weight, warmth, pressure. No need to change anything.</item>
        <item>Calves, knees, thighs. Notice where they touch the chair.</item>
        <item>Feel them rise and fall on their own.</item>
        <item>If the shoulders are lifted, let them drop.</item>
        <item>Then sense the whole body at once, sitting here.</item>
    </string-array>

    <string name="p_three">Notice three things</string>
    <string name="p_three_desc">Find three details you hadn’t seen before.</string>
    <string-array name="p_three_heads">
        <item>Look for something you usually ignore.</item>
        <item>Find a second detail.</item>
        <item>Find a third.</item>
    </string-array>
    <string-array name="p_three_hints">
        <item>A texture, a crack, a reflection.</item>
        <item>Look closer than you normally would.</item>
        <item>Then take a breath and return to what you were doing.</item>
    </string-array>

    <string name="p_start">Start-of-day pause</string>
    <string name="p_start_desc">Set one intention before the day starts.</string>
    <string-array name="p_start_heads">
        <item>Pause before you pick up your phone.</item>
        <item>Notice how you’re arriving today.</item>
        <item>Choose one intention.</item>
        <item>Carry it into the first task.</item>
    </string-array>
    <string-array name="p_start_hints">
        <item>Sit or stand still for three breaths.</item>
        <item>Rested, tired, restless — just name it.</item>
        <item>A few words. “Go slowly.” “Listen first.”</item>
        <item>You can come back to it whenever the bell rings.</item>
    </string-array>

    <string name="p_gratitude">Gratitude minute</string>
    <string name="p_gratitude_desc">Name one thing that went right.</string>
    <string-array name="p_gratitude_heads">
        <item>Think of one thing that went right today.</item>
        <item>Recall it in detail.</item>
        <item>Let yourself stay with it.</item>
    </string-array>
    <string-array name="p_gratitude_hints">
        <item>Small counts. Coffee, a message, the light.</item>
        <item>Where you were, who was there, what it felt like.</item>
        <item>For three breaths, nothing else to do.</item>
    </string-array>

    <string name="m_anchor">Breath anchor</string>
    <string name="m_anchor_desc">Stay with the breath, return when you wander.</string>
    <string-array name="m_anchor_titles">
        <item>Settle in</item>
        <item>Arrive at the breath</item>
        <item>Mind wandered?</item>
        <item>Deepen</item>
        <item>Return</item>
    </string-array>
    <string-array name="m_anchor_hints">
        <item>Find a posture you can rest in.</item>
        <item>One breath at a time, all the way through.</item>
        <item>Notice it, then come back. That is the practice.</item>
        <item>Softer breath, quieter mind.</item>
        <item>Sounds, body, room.</item>
    </string-array>

    <string name="m_kindness">Loving-kindness</string>
    <string name="m_kindness_desc">Wish well, starting with yourself.</string>
    <string-array name="m_kindness_titles">
        <item>Settle</item>
        <item>For yourself</item>
        <item>Someone dear</item>
        <item>A neutral face</item>
        <item>Someone difficult</item>
        <item>Let it widen</item>
    </string-array>
    <string-array name="m_kindness_hints">
        <item>Rest easy, eyes soft.</item>
        <item>May I be well. May I be at ease.</item>
        <item>Picture them and wish them the same.</item>
        <item>The barista, a neighbour, a stranger.</item>
        <item>Gently, without forcing it.</item>
        <item>Everyone, held kindly.</item>
    </string-array>

    <string name="m_mountain">Mountain sit</string>
    <string name="m_mountain_desc">Steady and unmoved, whatever passes.</string>
    <string-array name="m_mountain_titles">
        <item>Sit like a mountain</item>
        <item>Weather arrives</item>
        <item>Nothing to fix</item>
        <item>Simply steady</item>
        <item>Melt back</item>
    </string-array>
    <string-array name="m_mountain_hints">
        <item>Broad base, tall spine, still.</item>
        <item>Thoughts, sounds, moods — passing clouds.</item>
        <item>The mountain does not chase the weather.</item>
        <item>Just sitting. Just this.</item>
        <item>From rock to body again.</item>
    </string-array>

    <string name="m_walking">Walking meditation</string>
    <string name="m_walking_desc">Each step, fully arrived.</string>
    <string-array name="m_walking_titles">
        <item>Stand still first</item>
        <item>Slow steps</item>
        <item>Turn with care</item>
        <item>Find the rhythm</item>
        <item>The world walking</item>
        <item>Arrive</item>
    </string-array>
    <string-array name="m_walking_hints">
        <item>Feel both feet before you move.</item>
        <item>Lift, move, place. Know each one.</item>
        <item>Pause at the end of your line.</item>
        <item>Let the pace find itself.</item>
        <item>Air on skin, sounds coming and going.</item>
        <item>Stop, stand, three full breaths.</item>
    </string-array>

    <string name="m_sleep">Sleep wind-down</string>
    <string name="m_sleep_desc">Heavy, warm, and done for today.</string>
    <string-array name="m_sleep_titles">
        <item>Lie down</item>
        <item>Body release</item>
        <item>Count the breath</item>
        <item>The day, thanked</item>
        <item>Nothing left to do</item>
    </string-array>
    <string-array name="m_sleep_hints">
        <item>Let your weight drop into the bed.</item>
        <item>From the toes upward — heavy and warm.</item>
        <item>In, one… out, two… up to ten, then begin again.</item>
        <item>Let images drift past unopened.</item>
        <item>Nowhere to get to. Rest.</item>
    </string-array>

